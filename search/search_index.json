nodes.html#_46","title":"\u6309\u706f\u5149\u7c7b\u578b\u81ea\u52a8\u51fa\u73b0\u7684\u8f93\u51fa","text":"<ul> <li> <p><code>Position</code>\uff1a\u706f\u5149\u4e16\u754c\u4f4d\u7f6e</p> </li> <li> <p><code>Direction</code>\uff1a\u706f\u5149\u65b9\u5411</p> </li> <li> <p><code>Radius</code>\uff1a\u706f\u5149\u534a\u5f84</p> </li> <li> <p><code>Spot Size</code>\uff1a\u706f\u5149\u5c3a\u5bf8</p> </li> <li> <p><code>Sun Angle</code>\uff1a\u592a\u9633\u89d2\u5ea6</p> </li> </ul>"},{"location":"extended-nodes.html#_47","title":"\u8bf4\u660e","text":"<ul> <li>\u5982\u679c\u4f60\u8981\u505a\u9010\u706f\u5904\u7406\uff0c\u5e94\u8be5\u4f7f\u7528 <code>NPR Tree</code> \u91cc\u7684 <code>For Each Light</code>\u3002</li> </ul>"},{"location":"extended-nodes.html#scene-color","title":"Scene Color","text":""},{"location":"extended-nodes.html#_48","title":"\u5165\u53e3","text":"<p><code>Add &gt; Input &gt; Scene Color</code></p> <p></p> <p>\u4ec5\u5728 <code>Filter</code> \u57df\u4e0b\u53ef\u7528\u3002</p>"},{"location":"extended-nodes.html#_49","title":"\u4f5c\u7528","text":"<p>\u8bfb\u53d6 Eevee \u5f53\u524d\u573a\u666f\u7f13\u51b2\uff0c\u53ef\u5728\u8282\u70b9\u9762\u677f\u4e2d\u5207\u6362 <code>Source</code>\uff1a</p> <ul> <li> <p><code>Color</code>\uff1a\u8bfb\u53d6\u6e32\u67d3\u7684\u6700\u7ec8\u573a\u666f\u989c\u8272</p> </li> <li> <p><code>Depth</code>\uff1a\u8bfb\u53d6\u7ebf\u6027\u6df1\u5ea6\u503c</p> </li> <li> <p><code>Normal</code>\uff1a\u8bfb\u53d6\u6e32\u67d3\u6cd5\u7ebf</p> </li> <li> <p><code>Position</code>\uff1a\u8bfb\u53d6\u4e16\u754c\u7a7a\u95f4\u5750\u6807</p> </li> </ul>"},{"location":"extended-nodes.html#_50","title":"\u8f93\u5165\u8f93\u51fa","text":"<ul> <li> <p>\u8f93\u5165\uff1a<code>Vector</code></p> </li> <li> <p>\u8f93\u51fa\uff1a<code>Color</code>\u3001<code>Alpha</code></p> </li> </ul>"},{"location":"interface-guide.html","title":"\u56db\u3001\u754c\u9762\u4e0e\u5de5\u4f5c\u6d41\u8865\u5145","text":""},{"location":"interface-guide.html#1","title":"1. \u6750\u8d28\u9009\u62e9\u5668\u9884\u89c8\u5f00\u5173","text":""},{"location":"interface-guide.html#_2","title":"\u4f5c\u7528","text":"<p>\u63a7\u5236\u6750\u8d28\u4e0b\u62c9\u5217\u8868 / \u641c\u7d22\u5217\u8868\u4e2d\u662f\u5426\u6e32\u67d3\u6750\u8d28\u9884\u89c8\u56fe\u3002</p> <p>\u8fd9\u4e2a\u5f00\u5173\u4e3b\u8981\u7528\u4e8e\u5728\u6750\u8d28\u5f88\u591a\u65f6\uff0c\u51cf\u5c11\u5c55\u5f00\u6750\u8d28\u9009\u62e9\u5668\u65f6\u751f\u6210\u9884\u89c8\u56fe\u7684\u5361\u987f\u3002</p>"},{"location":"interface-guide.html#_3","title":"\u5165\u53e3","text":"<p><code>Edit &gt; Preferences &gt; Editing &gt; Objects &gt; Materials &gt; Material Selector Previews</code></p>"},{"location":"interface-guide.html#_4","title":"\u884c\u4e3a\u8bf4\u660e","text":"<ul> <li> <p>\u5f00\u542f\u65f6\uff1a\u6750\u8d28\u9009\u62e9\u5668\u4f1a\u6309\u5f53\u524d\u903b\u8f91\u663e\u793a\u6750\u8d28\u9884\u89c8\u56fe\u3002</p> </li> <li> <p>\u5173\u95ed\u65f6\uff1a\u6750\u8d28\u9009\u62e9\u5668\u4f1a\u9000\u56de\u666e\u901a\u6750\u8d28\u56fe\u6807\uff0c\u4e0d\u518d\u5728\u4e0b\u62c9\u5217\u8868\u91cc\u89e6\u53d1\u6750\u8d28\u9884\u89c8\u6e32\u67d3\u3002</p> </li> <li> <p>\u9ed8\u8ba4\u503c\u4e3a\u5f00\u542f\u3002</p> </li> </ul>"},{"location":"interface-guide.html#_5","title":"\u5f53\u524d\u8303\u56f4","text":"<ul> <li> <p>\u76ee\u524d\u53ea\u5f71\u54cd <code>template_ID(...)</code> \u8fd9\u7c7b\u6750\u8d28\u9009\u62e9\u5668\u4e0b\u62c9\u5217\u8868\u4e2d\u7684\u6750\u8d28\u9884\u89c8\u663e\u793a\u3002</p> </li> <li> <p>\u4e0d\u5f71\u54cd <code>Material Properties</code> \u9762\u677f\u4e2d\u7684\u5927\u9884\u89c8\u7403\u3002</p> </li> <li> <p>\u4e0d\u5f71\u54cd\u6750\u8d28\u672c\u8eab\u7684\u6b63\u5e38\u6e32\u67d3\u7ed3\u679c\u3002</p> </li> </ul>"},{"location":"interface-guide.html#2","title":"2. \u4e16\u754c\u73af\u5883\u6392\u9664","text":""},{"location":"interface-guide.html#_6","title":"\u884c\u4e3a\u8bf4\u660e","text":"<ul> <li>\u5141\u8bb8\u9009\u62e9\u4e00\u4e2a\u96c6\u5408,\u9009\u62e9\u7684\u96c6\u5408\u4e0d\u53d7\u4e16\u754c\u73af\u5883\u5f71\u54cd</li> </ul>"},{"location":"npr-workflow.html","title":"\u4e09\u3001NPR Tree \u5de5\u4f5c\u6d41","text":""},{"location":"npr-workflow.html#1","title":"1. \u57fa\u672c\u6982\u5ff5","text":"<p><code>NPR Tree</code> \u662f\u6302\u5728\u666e\u901a\u7269\u4f53\u6750\u8d28\u4e4b\u540e\u8fdb\u884c\u989c\u8272\u540e\u5904\u7406\u7684\u8282\u70b9\u6811,\u80fd\u591f\u4ee5\u989c\u8272\u7684\u5f62\u5f0f\u5bf9\u7740\u8272\u5668\u7684\u8f93\u51fa\u8fdb\u884c\u98ce\u683c\u5316\u5904\u7406.</p>"},{"location":"npr-workflow.html#2","title":"2. \u6302\u63a5\u65b9\u5f0f","text":"<ol> <li> <p>\u5728\u666e\u901a\u7269\u4f53\u6750\u8d28\u4e2d\u4fdd\u7559\u6b63\u5e38\u7684 <code>Material Output</code> \u548c\u57fa\u7840\u8868\u9762\u7740\u8272\u3002</p> </li> <li> <p>\u9009\u4e2d <code>Material Output</code> \u8282\u70b9\u3002</p> </li> <li> <p>\u5728\u5b83\u7684 <code>NPR Tree</code> \u5c5e\u6027\u91cc\u65b0\u5efa\u6216\u6307\u5b9a\u4e00\u4e2a\u8282\u70b9\u7ec4\u3002</p> </li> </ol> <ol> <li>\u9700\u8981\u7f16\u8f91\u8fd9\u68f5\u6811\u65f6\uff0c\u5728 Shader Editor \u9876\u90e8\u628a <code>Shader Type</code> \u5207\u5230 <code>NPR</code>\u3002</li> </ol>"},{"location":"npr-workflow.html#3","title":"3. \u8bf4\u660e","text":"<ul> <li> <p>\u6750\u8d28\u7684\u6e32\u67d3\u65b9\u5f0f\u9700\u8981\u8bbe\u7f6e\u4e3a<code>\u6296\u52a8(\u5ef6\u8fdf\u6e32\u67d3)</code></p> </li> <li> <p>\u53ef\u4ee5\u4f7f\u7528<code>Ctrl + Tab</code>\u5728\u7269\u4f53\u548cNPR\u4e4b\u95f4\u5feb\u901f\u5207\u6362</p> </li> </ul>"},{"location":"npr-workflow.html#4-npr","title":"4. \u4e3b\u8981 NPR \u8282\u70b9","text":"<p>\u9664\u4e86\u4e0b\u9762\u8fd9\u4e9b\u4e13\u7528 NPR \u8282\u70b9\u4ee5\u5916\uff0c<code>Curvature</code> \u548c <code>Raycast</code> \u73b0\u5728\u4e5f\u53ef\u4ee5\u76f4\u63a5\u5728 <code>NPR Tree</code> \u4e2d\u4f7f\u7528\u3002</p>"},{"location":"npr-workflow.html#npr-input","title":"NPR Input","text":""},{"location":"npr-workflow.html#_1","title":"\u4f5c\u7528","text":"<p>\u8bfb\u53d6 NPR \u6e32\u67d3\u9636\u6bb5\u63d0\u4f9b\u7684\u8f93\u5165\u7f13\u51b2\u3002</p>"},{"location":"npr-workflow.html#_2","title":"\u8f93\u51fa","text":"<ul> <li> <p><code>Combined Color</code>\uff1a\u5408\u6210\u4e4b\u540e\u7684\u6700\u7ec8\u989c\u8272</p> </li> <li> <p><code>Diffuse Color</code>\uff1a\u6f2b\u5c04\u989c\u8272</p> </li> <li> <p><code>Diffuse Direct</code>\uff1a\u6f2b\u5c04\u76f4\u63a5\u5149</p> </li> <li> <p><code>Diffuse Indirect</code>\uff1a\u6f2b\u5c04\u95f4\u63a5\u5149(\u5149\u7ebf\u8ffd\u8e2a,\u63a2\u9488)</p> </li> <li> <p><code>Specular Color</code>\uff1a\u9ad8\u5149\u989c\u8272</p> </li> <li> <p><code>Specular Direct</code>\uff1a\u9ad8\u5149</p> </li> <li> <p><code>Specular Indirect</code>\uff1a\u95f4\u63a5\u53cd\u5c04</p> </li> <li> <p><code>Position</code>\uff1a\u4e16\u754c\u7a7a\u95f4\u4f4d\u7f6e</p> </li> <li> <p><code>Normal</code>\uff1a\u6cd5\u7ebf</p> </li> </ul> <p>\u8fd9\u4e9b\u8f93\u51fa\u672c\u8d28\u4e0a\u66f4\u63a5\u8fd1\u56fe\u50cf\u53e5\u67c4 / \u7eb9\u7406\u53e5\u67c4\uff0c\u9002\u5408\u7ee7\u7eed\u4ea4\u7ed9 <code>Image Sample</code> \u505a\u90bb\u57df\u91c7\u6837\uff0c\u6216\u63a5\u5230\u652f\u6301\u8fd9\u7c7b\u8f93\u5165\u7684 NPR \u8282\u70b9\u4e0a\u7ee7\u7eed\u5904\u7406\u3002</p>"},{"location":"npr-workflow.html#npr-refraction","title":"NPR Refraction","text":""},{"location":"npr-workflow.html#_3","title":"\u4f5c\u7528","text":"<p>\u8bfb\u53d6\u6298\u5c04\u76f8\u5173\u7f13\u51b2,\u7c7b\u4f3c<code>Screenspace Info</code></p> <p>\u53c2\u8003<code>Screenspace Info</code>\u8282\u70b9\u7684\u4f7f\u7528\u8bf4\u660e</p>"},{"location":"npr-workflow.html#_4","title":"\u8f93\u51fa","text":"<ul> <li> <p><code>Combined Color</code>\uff1a\u6298\u5c04\u4e8b\u4ef6\u7684\u6700\u7ec8\u989c\u8272</p> </li> <li> <p><code>Position</code>\uff1a\u6298\u5c04\u4f4d\u7f6e\u7684\u4e16\u754c\u5750\u6807</p> </li> </ul>"},{"location":"npr-workflow.html#image-sample","title":"Image Sample","text":""},{"location":"npr-workflow.html#_5","title":"\u5165\u53e3","text":"<p><code>Add &gt; Utilities &gt; Image Sample</code></p>"},{"location":"npr-workflow.html#_6","title":"\u8f93\u5165\u8f93\u51fa","text":"<ul> <li> <p>\u8f93\u5165\uff1a<code>Image</code>\uff08\u56fe\u50cf\u53e5\u67c4\uff09\u3001<code>Offset</code>\uff08\u91c7\u6837\u504f\u79fb\uff09</p> </li> <li> <p>\u8f93\u51fa\uff1a<code>Color</code>\uff08\u91c7\u6837\u7ed3\u679c\u989c\u8272\uff09</p> </li> </ul>"},{"location":"npr-workflow.html#_7","title":"\u4f5c\u7528","text":"<p>\u5bf9 <code>NPR Input</code> / <code>NPR Refraction</code> \u4e4b\u7c7b\u8f93\u51fa\u7684\u56fe\u50cf\u53e5\u67c4\u505a\u91c7\u6837\u3002</p>"},{"location":"npr-workflow.html#_8","title":"\u504f\u79fb\u6a21\u5f0f","text":"<ul> <li> <p><code>View</code>\uff1a\u6309\u89c6\u7a7a\u95f4\u504f\u79fb</p> </li> <li> <p><code>Pixel</code>\uff1a\u6309\u50cf\u7d20\u504f\u79fb</p> </li> </ul>"},{"location":"npr-workflow.html#for-each-light","title":"For Each Light","text":""},{"location":"npr-workflow.html#_9","title":"\u5165\u53e3","text":"<p><code>Add &gt; Utilities &gt; For Each Light</code></p>"},{"location":"npr-workflow.html#_10","title":"\u8bf4\u660e","text":"<p>\u5b83\u4f1a\u6309\u5f53\u524d\u5f71\u54cd\u8868\u9762\u7684\u706f\u5149\u9010\u4e2a\u6267\u884c\u5185\u90e8\u903b\u8f91,\u6bcf\u6b21\u5faa\u73af\u8f93\u51fa\u4e00\u4e2a\u706f\u5149\u7684\u4fe1\u606f</p>"},{"location":"npr-workflow.html#_11","title":"\u5185\u7f6e\u53ef\u7528\u4fe1\u606f","text":"<p><code>For Each Light Input</code> \u5f53\u524d\u63d0\u4f9b\uff1a</p> <ul> <li> <p>\u8f93\u5165\uff1a<code>Normal</code>\uff08\u8868\u9762\u6cd5\u7ebf\uff09</p> </li> <li> <p>\u8f93\u51fa\uff1a<code>Color</code>\uff08\u706f\u5149\u989c\u8272\uff09\u3001<code>Direction</code>\uff08\u706f\u5149\u65b9\u5411\uff09\u3001<code>Distance</code>\uff08\u706f\u5149\u8ddd\u79bb\uff09\u3001<code>Attenuation</code>\uff08\u706f\u5149\u8870\u51cf\uff09\u3001<code>Shadow Mask</code>\uff08\u9634\u5f71\u906e\u7f69\uff09</p> </li> </ul>"},{"location":"npr-workflow.html#npr","title":"\u5185\u7f6e NPR \u8282\u70b9\u7ec4\u8d44\u4ea7","text":"<p>\u5f53\u524d\u7248\u672c\u5df2\u7ecf\u628a Blender 4.4 NPR \u7248\u672c\u4e2d\u7684\u4e00\u6279\u5e38\u7528\u8282\u70b9\u7ec4\uff0c\u8fc1\u79fb\u5e76\u6574\u7406\u6210\u4e86 5.1 \u53ef\u7528\u7684\u8d44\u4ea7\u5305\u3002</p>"},{"location":"npr-workflow.html#_12","title":"\u5f53\u524d\u5185\u7f6e\u7684\u4e3b\u8981\u8282\u70b9\u7ec4","text":"<ul> <li> <p><code>Cavity</code></p> </li> <li> <p><code>Co-Planar Edge Detection</code></p> </li> <li> <p><code>Curvature</code></p> </li> <li> <p><code>Kuwahara</code></p> </li> <li> <p><code>Shading Models</code></p> </li> <li> <p><code>Surface Curvature</code></p> </li> </ul>"},{"location":"npr-workflow.html#_13","title":"\u8d44\u4ea7\u8bf4\u660e","text":"<ul> <li> <p>\u8fd9\u4e9b\u8282\u70b9\u7ec4\u5df2\u7ecf\u6309 Blender 5.1 \u7684\u683c\u5f0f\u8fc1\u79fb\u3002</p> </li> <li> <p>\u7531\u4e8e\u91cd\u590d\u533a\u57df\u8282\u70b9\u540d\u79f0\u4fee\u6539\u4e86,4.4 npr\u539f\u578b\u7684\u5de5\u7a0b\u9700\u8981\u81ea\u5df1\u91cd\u65b0\u8fde\u63a5\u91cd\u65b0\u533a\u57df\u76f8\u5173\u7684\u8282\u70b9</p> </li> </ul>"},{"location":"scene-extensions.html","title":"\u4e00\u3001Scene \u7ea7 Eevee \u6269\u5c55","text":""},{"location":"scene-extensions.html#1-render-textures","title":"1. Render Textures","text":""},{"location":"scene-extensions.html#_1","title":"\u529f\u80fd\u8bf4\u660e","text":"<p><code>Render Textures</code> \u662f\u573a\u666f\u7ea7\u7684 Eevee \u989d\u5916\u6e32\u67d3\u7eb9\u7406\u7cfb\u7edf\u3002</p> <p>\u5b83\u5141\u8bb8\u573a\u666f\u9884\u5148\u7ef4\u62a4\u6700\u591a <code>4</code> \u4e2a Render Texture \u69fd\u4f4d\uff0c\u6bcf\u4e2a\u69fd\u4f4d\u90fd\u53ef\u4ee5\u6307\u5b9a\u4e00\u4e2a\u76f8\u673a\u548c\u4e00\u4e2a\u8f93\u51fa\u7c7b\u578b\uff0c\u628a\u8be5\u76f8\u673a\u89c6\u89d2\u4e0b\u7684\u573a\u666f\u7ed3\u679c\u5148\u6e32\u67d3\u6210\u7eb9\u7406\uff0c\u518d\u5728\u666e\u901a\u7269\u4f53\u6750\u8d28\u4e2d\u901a\u8fc7 <code>Render Texture</code> \u8282\u70b9\u91c7\u6837\u3002</p>"},{"location":"scene-extensions.html#_2","title":"\u9762\u677f\u5165\u53e3","text":"<p><code>Scene Properties &gt; Render Textures</code></p>"},{"location":"scene-extensions.html#_3","title":"\u53ef\u914d\u7f6e\u5185\u5bb9","text":"<p>\u6bcf\u4e2a Render Texture \u6761\u76ee\u5f53\u524d\u652f\u6301\uff1a</p> <pre><code>- `Color`\uff1a\u6355\u83b7\u6700\u7ec8 Eevee \u989c\u8272\n\n- `Depth`\uff1a\u6355\u83b7\u7ebf\u6027\u6df1\u5ea6\n\n- `Normal`\uff1a\u6355\u83b7\u6cd5\u7ebf\n\n\n\n\n- `Every Sample`\uff1a\u6bcf\u6b21\u91c7\u6837\u65f6\u66f4\u65b0\n\n- `Every Frame`\uff1a\u6bcf\u5e27\u66f4\u65b0\u4e00\u6b21\n\n- `Manual`\uff1a\u624b\u52a8\u66f4\u65b0\n\n\n- `RGBA16F`\uff1a16\u4f4d\u6d6e\u70b9\u989c\u8272\uff0c\u5e73\u8861\u8d28\u91cf\u548c\u6027\u80fd\n\n- `RGBA32F`\uff1a32\u4f4d\u9ad8\u7cbe\u5ea6\u989c\u8272\uff0c\u8981\u6c42\u66f4\u9ad8\u663e\u5b58\n\n- `R16F`\uff1a16\u4f4d\u6d6e\u70b9\u6df1\u5ea6\u503c\n\n- `R32F`\uff1a32\u4f4d\u9ad8\u7cbe\u5ea6\u6df1\u5ea6\u503c\n</code></pre>"},{"location":"scene-extensions.html#_4","title":"\u57fa\u672c\u4f7f\u7528\u65b9\u6cd5","text":"<ol> <li> <p>\u6253\u5f00 <code>Scene Properties &gt; Render Textures</code>\u3002</p> </li> <li> <p>\u65b0\u5efa\u4e00\u4e2a <code>Render Texture</code> \u6761\u76ee\u3002</p> </li> <li> <p>\u9009\u62e9 <code>Source</code>\u3001<code>Camera</code>\u3001\u5206\u8fa8\u7387\u3001\u5237\u65b0\u6a21\u5f0f\u548c\u683c\u5f0f\u3002</p> </li> <li> <p>\u5728\u666e\u901a\u7269\u4f53\u6750\u8d28\u91cc\u6dfb\u52a0 <code>Add &gt; Texture &gt; Render Texture</code> \u8282\u70b9\u3002</p> </li> <li> <p>\u5728\u8282\u70b9\u9762\u677f\u4e2d\u9009\u62e9\u5bf9\u5e94\u7684 <code>Render Texture</code> \u6761\u76ee\u3002</p> </li> <li> <p>\u4f7f\u7528\u8282\u70b9\u8f93\u51fa\u7684 <code>Color</code> / <code>Alpha</code> \u53c2\u4e0e\u540e\u7eed\u6750\u8d28\u8ba1\u7b97\u3002</p> </li> </ol>"},{"location":"scene-extensions.html#2-filter-materials","title":"2. Filter Materials","text":""},{"location":"scene-extensions.html#_5","title":"\u529f\u80fd\u8bf4\u660e","text":"<p>\u5b83\u662f\u4e00\u5957\u573a\u666f\u7ea7\u7684 Eevee \u5168\u5c4f\u6ee4\u955c\u6808\u3002\u6bcf\u4e2a\u6761\u76ee\u90fd\u662f\u4e00\u4e2a <code>Filter</code> \u57df\u6750\u8d28\uff0c\u6309\u5217\u8868\u987a\u5e8f\u4f9d\u6b21\u5bf9\u5f53\u524d\u5e27\u8fdb\u884c\u5904\u7406\u3002</p>"},{"location":"scene-extensions.html#_6","title":"\u9762\u677f\u5165\u53e3","text":"<p><code>Scene Properties &gt; Filter Materials</code></p> <p>\u8282\u70b9\u6811\u5165\u53e3: \u7740\u8272\u5668\u8282\u70b9\u7f16\u8f91\u5668 &gt; \u7740\u8272\u5668\u7c7b\u578b &gt; Filter</p>"},{"location":"scene-extensions.html#_7","title":"\u57fa\u672c\u4f7f\u7528\u65b9\u6cd5","text":"<ol> <li> <p>\u6253\u5f00 <code>Scene Properties &gt; Filter Materials</code>\u3002</p> </li> <li> <p>\u65b0\u5efa\u4e00\u4e2a\u6761\u76ee\uff0c\u6216\u8005\u76f4\u63a5\u70b9 <code>New Filter Material</code>\u3002</p> </li> <li> <p>\u9009\u4e2d\u7684\u6750\u8d28\u5fc5\u987b\u662f <code>Filter</code> \u57df\u6750\u8d28\u3002</p> </li> <li> <p>\u6253\u5f00 Shader Editor\uff0c\u628a\u9876\u90e8 <code>Shader Type</code> \u5207\u6362\u5230 <code>Filter</code>\u3002</p> </li> <li> <p>\u5728\u6ee4\u955c\u6750\u8d28\u91cc\u4f7f\u7528 <code>Scene Color</code> \u8bfb\u53d6\u573a\u666f\u6570\u636e\uff0c\u7528 <code>Filter Output</code> \u8f93\u51fa\u7ed3\u679c\u3002</p> </li> <li> <p>\u901a\u8fc7 <code>Execution Stage</code> \u9009\u62e9\u6ee4\u955c\u6267\u884c\u4f4d\u7f6e\u3002</p> </li> </ol>"},{"location":"scene-extensions.html#_8","title":"\u91cd\u8981\u8bf4\u660e","text":"<pre><code>- `Before Volume Fog`\uff1a\u5728\u4f53\u79ef\u96fe\u5904\u7406\u524d\u6267\u884c\n\n- `Before Depth of Field`\uff1a\u5728\u666f\u6df1\u524d\u6267\u884c\n\n- `Before Composite`\uff1a\u5728\u5408\u6210\u5668\u524d\u6267\u884c\n</code></pre>"}]}